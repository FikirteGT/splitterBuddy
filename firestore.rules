rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid ||
          ('memberIds' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds) ||
          ('members' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members)
        );
    }

    function isWorkspaceAdminOrOwner(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid ||
          (
            'memberRoles' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data &&
            request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberRoles &&
            (
              get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberRoles[request.auth.uid] == 'ADMIN' ||
              get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberRoles[request.auth.uid] == 'OWNER'
            )
          )
        );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false;

      // Private notifications
      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(userId);
        // Allow other workspace members to create notifications for this user
        allow create: if isAuthenticated();
      }
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      // Query workspace by invite code (needed for joining) or read if member
      allow list, get: if isAuthenticated();

      // Create workspace (must set self as owner and only member)
      allow create: if isAuthenticated() &&
                    request.resource.data.ownerId == request.auth.uid &&
                    request.resource.data.memberIds.size() == 1 &&
                    request.resource.data.memberIds[0] == request.auth.uid;

      // Update workspace (Joining with max 10 members limit or member state updates)
      allow update: if isAuthenticated() && (
        // Joining: workspace must have < 10 members, and adding self
        (resource.data.memberIds.size() < 10 &&
         request.resource.data.memberIds.size() <= 10 &&
         request.auth.uid in request.resource.data.memberIds) ||
        // Existing member updating active period, roles, or workspace details
        (request.auth.uid in resource.data.memberIds)
      );

      // Only owner can delete workspace
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId) &&
                      request.resource.data.amount > 0 &&
                      request.resource.data.description.size() > 0;
        allow update, delete: if isWorkspaceMember(workspaceId);
      }

      // Recurring Expenses Subcollection
      match /recurringExpenses/{recurringId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      // Budgets Subcollection
      match /budgets/{budgetId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      // Settlement Obligations Subcollection
      match /obligations/{obligationId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      // Pending Changes Subcollection (Partner Edit Approvals)
      match /pendingChanges/{changeId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      // Activity Logs Subcollection
      match /activityLogs/{logId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isAuthenticated();
        allow update, delete: if false; // Immutable audit log
      }

      // Settlements Subcollection
      match /settlements/{settlementId} {
        allow read, create: if isWorkspaceMember(workspaceId) &&
                            request.resource.data.amount > 0;
        allow update, delete: if false; // Immutable settlement records
      }

      // Expense Periods Subcollection
      match /periods/{periodId} {
        allow read, update: if isWorkspaceMember(workspaceId);
        allow create: if isAuthenticated();
        allow delete: if false;
      }
    }
  }
}
